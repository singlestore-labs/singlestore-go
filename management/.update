#!/usr/bin/env bash

set -euxo pipefail

root="$(git rev-parse --show-toplevel)"
schema="${root}/management/management.yaml"

cd "${root}"/management

curl -sS https://api.singlestore.com/spec > ${schema}

go install github.com/mikefarah/yq/v4@v4.54.1

# Merge v1 endpoints that were public in spec 1.2.158 and hidden in 1.2.178.
# Components already present in the public spec take precedence over the overlay.
yq -i '
  . as $live |
  load("v1-compat.yaml") as $o |
  .paths = .paths * ($o.paths | with_entries(select(.key as $k | $live.paths | has($k) | not))) |
  .components.schemas = .components.schemas * ($o.components.schemas | with_entries(select(.key as $k | $live.components.schemas | has($k) | not))) |
  .components.parameters = .components.parameters * ($o.components.parameters | with_entries(select(.key as $k | $live.components.parameters | has($k) | not)))
' "${schema}"

version_without_prefix="v$(cat ${schema} | yq .info.version)"
version="management/${version_without_prefix}"

echo "Updating the client to version ${version}..."

cleanup() {
    rm "${schema}"
}
trap cleanup EXIT

go install github.com/oapi-codegen/oapi-codegen/v2/cmd/oapi-codegen@v2.8.1
output="${root}/management/management.go"
oapi-codegen -package management -generate types,client -o "${output}" "${schema}"

go mod tidy
go build

if [[ $(git status ${output} --porcelain) ]]; then
    git config user.email "ci@singlestorelabs.com"
    git config user.name "CI"
    git add "${output}" go.mod go.sum
    git commit -m "Updating the client to version ${version}" || true
    git tag ${version}
    git push origin ${version}
    git push
    curl -sS https://proxy.golang.org/github.com/singlestore-labs/singlestore-go/management/@v/${version_without_prefix}.info
    echo "Successfully updated the client to version ${version}!"
else
    echo "The SDK is already up to date with the latest released version ${version}"
fi
